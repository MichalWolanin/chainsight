{
  "name": "security-data-access-auth",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/security/data-access-auth/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": ["scope:security", "type:data-access"],
  "targets": {
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "defaultConfiguration": "production",
      "options": {
        "project": "libs/security/data-access-auth/ng-package.json",
        "tsConfig": "libs/security/data-access-auth/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/security/data-access-auth/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "options": {
        "watch": false
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
